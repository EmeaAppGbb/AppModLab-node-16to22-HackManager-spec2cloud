{
  "name": "legacynode16app",
  "version": "1.0.0",
  "description": "Hackathon Management System - Built with Node.js",
  "main": "src/app.js",
  "scripts": {
    "start": "node src/app.js",
    "dev": "nodemon src/app.js",
    "seed": "node seeds/seed.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src/ seeds/",
    "lint:fix": "eslint src/ seeds/ --fix",
    "format": "prettier --write \"src/**/*.js\" \"seeds/**/*.js\""
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "^12.8.0",
    "better-sqlite3-session-store": "^0.1.0",
    "cookie-parser": "^1.4.7",
    "csrf-csrf": "^4.0.3",
    "date-fns": "^4.1.0",
    "dotenv": "^17.3.1",
    "ejs": "^3.1.9",
    "express": "^4.18.2",
    "express-rate-limit": "^8.3.2",
    "express-session": "^1.17.3",
    "express-validator": "^7.3.1",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.1.0",
    "globals": "^17.4.0",
    "nodemon": "^3.1.14",
    "prettier": "^3.8.1",
    "supertest": "^7.2.2",
    "vitest": "^4.1.2"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
