<%- include('layout/header') %>

<div class="row justify-content-center mt-5">
  <div class="col-md-6 text-center">
    <h1 class="display-1 text-muted">
      <%= (typeof error !== 'undefined' && error && error.status) ? error.status : '500' %>
    </h1>
    <h3>
      <%= (typeof error !== 'undefined' && error && error.message) ? error.message : 'Something went wrong' %>
    </h3>
    <p class="text-muted mt-3">Sorry, an error occurred while processing your request.</p>
    <a href="/" class="btn btn-primary mt-3">Go Home</a>
  </div>
</div>

<%- include('layout/footer') %>
