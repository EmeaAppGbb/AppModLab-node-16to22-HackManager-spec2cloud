<%- include('../layout/header') %>

<div class="mb-4">
  <h2><%= submission.title %></h2>
  <p class="text-muted">
    Team: <%= submission.team_name %> | Hackathon: <%= submission.hackathon_name %>
  </p>
</div>

<div class="card mb-4">
  <div class="card-body">
    <p><%= submission.description %></p>
    <% if (submission.demo_url) { %>
      <p><strong>Demo:</strong> <a href="<%= submission.demo_url %>" target="_blank" rel="noopener"><%= submission.demo_url %></a></p>
    <% } %>
    <% if (submission.repo_url) { %>
      <p><strong>Repository:</strong> <a href="<%= submission.repo_url %>" target="_blank" rel="noopener"><%= submission.repo_url %></a></p>
    <% } %>
    <p class="text-muted mb-0"><small>Submitted: <%= submission.submitted_at %></small></p>
  </div>
</div>

<!-- Scores Section -->
<h4 class="mb-3">Scores</h4>

<% if (scores && scores.length > 0) { %>
  <div class="table-responsive">
    <table class="table table-hover">
      <thead class="thead-light">
        <tr>
          <th>Judge</th>
          <th>Innovation</th>
          <th>Technical</th>
          <th>Presentation</th>
          <th>Impact</th>
          <th>Overall</th>
          <th>Comments</th>
        </tr>
      </thead>
      <tbody>
        <%
          var totalInnovation = 0, totalTechnical = 0, totalPresentation = 0, totalImpact = 0, totalOverall = 0;
          scores.forEach(function(sc) {
            totalInnovation += sc.innovation;
            totalTechnical += sc.technical;
            totalPresentation += sc.presentation;
            totalImpact += sc.impact;
            totalOverall += sc.overall;
        %>
          <tr>
            <td><%= sc.username %></td>
            <td><%= sc.innovation %></td>
            <td><%= sc.technical %></td>
            <td><%= sc.presentation %></td>
            <td><%= sc.impact %></td>
            <td><strong><%= sc.overall %></strong></td>
            <td><%= sc.comments %></td>
          </tr>
        <% }); %>
      </tbody>
      <tfoot class="table-info">
        <tr>
          <td><strong>Average</strong></td>
          <td><%= (totalInnovation / scores.length).toFixed(1) %></td>
          <td><%= (totalTechnical / scores.length).toFixed(1) %></td>
          <td><%= (totalPresentation / scores.length).toFixed(1) %></td>
          <td><%= (totalImpact / scores.length).toFixed(1) %></td>
          <td><strong><%= (totalOverall / scores.length).toFixed(1) %></strong></td>
          <td></td>
        </tr>
      </tfoot>
    </table>
  </div>
<% } else { %>
  <p class="text-muted">No scores yet.</p>
<% } %>

<div class="mt-3">
  <% if (typeof user !== 'undefined' && user) { %>
    <a href="/submissions/<%= submission.id %>/judge" class="btn btn-primary">Judge This</a>
  <% } %>
  <a href="/submissions" class="btn btn-outline-secondary ml-2">&larr; Back to Submissions</a>
</div>

<%- include('../layout/footer') %>
