<%- include('../layout/header') %>

<h2 class="mb-4">New Submission for <%= hackathon.name %></h2>

<form action="/hackathons/<%= hackathon.id %>/submissions" method="POST">
  <div class="form-group">
    <label for="title">Submission Title</label>
    <input type="text" class="form-control" id="title" name="title" required placeholder="Enter submission title">
  </div>

  <div class="form-group">
    <label for="description">Description</label>
    <textarea class="form-control" id="description" name="description" rows="4" placeholder="Describe your submission"></textarea>
  </div>

  <div class="form-group">
    <label for="team_id">Team</label>
    <select class="form-control" id="team_id" name="team_id" required>
      <option value="">Select a team...</option>
      <% teams.forEach(function(t) { %>
        <option value="<%= t.id %>"><%= t.name %></option>
      <% }); %>
    </select>
  </div>

  <div class="form-row">
    <div class="form-group col-md-6">
      <label for="demo_url">Demo URL</label>
      <input type="url" class="form-control" id="demo_url" name="demo_url" placeholder="https://your-demo.com">
    </div>
    <div class="form-group col-md-6">
      <label for="repo_url">Repository URL</label>
      <input type="url" class="form-control" id="repo_url" name="repo_url" placeholder="https://github.com/...">
    </div>
  </div>

  <button type="submit" class="btn btn-primary">Submit</button>
  <a href="/hackathons/<%= hackathon.id %>" class="btn btn-secondary ml-2">Cancel</a>
</form>

<%- include('../layout/footer') %>
