<%- include('layout/header') %>

<div class="jumbotron">
  <h1 class="display-4">Welcome to HackManager</h1>
  <p class="lead">The ultimate platform to organize, manage, and judge hackathons. Track teams, submissions, and scores all in one place.</p>
  <hr class="my-4">
  <p>Get started by browsing hackathons or creating a new one.</p>
  <a class="btn btn-primary btn-lg" href="/hackathons" role="button">Browse Hackathons</a>
</div>

<div class="row mb-4">
  <div class="col-md-4">
    <div class="card stat-card text-center">
      <div class="card-body">
        <h5 class="card-title text-muted">Total Hackathons</h5>
        <p class="display-4"><%= stats.totalHackathons %></p>
      </div>
    </div>
  </div>
  <div class="col-md-4">
    <div class="card stat-card text-center">
      <div class="card-body">
        <h5 class="card-title text-muted">Total Teams</h5>
        <p class="display-4"><%= stats.totalTeams %></p>
      </div>
    </div>
  </div>
  <div class="col-md-4">
    <div class="card stat-card text-center">
      <div class="card-body">
        <h5 class="card-title text-muted">Total Participants</h5>
        <p class="display-4"><%= stats.totalParticipants %></p>
      </div>
    </div>
  </div>
</div>

<h3 class="mb-3">Recent Hackathons</h3>
<div class="row">
  <% if (hackathons && hackathons.length > 0) { %>
    <% hackathons.forEach(function(h) { %>
      <div class="col-md-4 mb-4">
        <div class="card h-100">
          <div class="card-body">
            <h5 class="card-title"><%= h.name %></h5>
            <p class="card-text">
              <small class="text-muted"><%= h.start_date %> — <%= h.end_date %></small>
            </p>
            <span class="badge badge-<%= h.status === 'active' ? 'success' : (h.status === 'upcoming' ? 'info' : 'secondary') %>">
              <%= h.status %>
            </span>
          </div>
          <div class="card-footer">
            <a href="/hackathons/<%= h.id %>" class="btn btn-sm btn-outline-primary">View Details</a>
          </div>
        </div>
      </div>
    <% }); %>
  <% } else { %>
    <div class="col-12">
      <p class="text-muted">No hackathons yet. Be the first to create one!</p>
    </div>
  <% } %>
</div>

<div class="text-center mt-3 mb-4">
  <a href="/hackathons" class="btn btn-outline-primary">View All Hackathons</a>
</div>

<%- include('layout/footer') %>
