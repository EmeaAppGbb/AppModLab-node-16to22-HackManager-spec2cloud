<%- include('../layout/header') %>

<h2 class="mb-4">Judging Dashboard</h2>

<% if (submissions && submissions.length > 0) { %>
  <div class="table-responsive">
    <table class="table table-hover">
      <thead class="thead-dark">
        <tr>
          <th>Submission</th>
          <th>Team</th>
          <th>Hackathon</th>
          <th>Action</th>
        </tr>
      </thead>
      <tbody>
        <% submissions.forEach(function(s) { %>
          <tr>
            <td><%= s.title %></td>
            <td><%= s.team_name %></td>
            <td><%= s.hackathon_name %></td>
            <td>
              <a href="/submissions/<%= s.id %>/judge" class="btn btn-sm btn-outline-warning">Score</a>
            </td>
          </tr>
        <% }); %>
      </tbody>
    </table>
  </div>
<% } else { %>
  <div class="alert alert-info">No submissions available for judging.</div>
<% } %>

<%- include('../layout/footer') %>
